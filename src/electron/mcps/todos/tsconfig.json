{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["*.ts", "lib/**/*.ts", "tools/**/*.ts", "ui/**/*.tsx", "ui/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}

{
  "name": "devkit",
  "version": "0.1.0",
  "description": "Devkit MCP - Developer toolkit with logs, MCP App refresh, and SDK docs",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:ui\"",
    "dev:server": "tsx watch devkit-server.ts",
    "dev:ui": "vite build --watch",
    "build:ui": "vite build --mode production"
  },
  "dependencies": {

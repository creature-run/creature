{
  "name": "terminal",
  "version": "0.1.0",
  "description": "Terminal MCP - Interactive terminal emulator",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:ui\"",
    "dev:server": "tsx watch terminal-server.ts",
    "dev:ui": "vite build --watch",
    "build:ui": "vite build --mode production"
  },
  "dependencies": {
    "open-mcp-app": "file:../../../../artifacts/sdk",
    "open-mcp-app-ui": "file:../../../../artifacts/sdk-ui"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.0.0",
    "postcss": "^8.5.0",
    "tsx": "^4.0.0",
    "vite": "^5.0.0",
    "vite-plugin-singlefile": "^2.0.0"
  }
}

{
  "name": "creature-desktop-app",
  "productName": "Creature",
  "version": "1.0.0",
  "description": "The desktop app for AI agents with rich, interactive components—powered by MCP Apps.",
  "main": ".vite/build/main.js",
  "build": {
    "appId": "run.creature.desktop",
    "publish": {
      "provider": "generic",
      "url": "https://releases.creature.run/desktop/darwin/arm64"
    }
  },
  "scripts": {
    "dev": "npm run build && API_URL=https://api.creature.run electron-forge start",
    "dev:quick": "electron-forge start",
    "dev:local": "npm run build && API_URL=http://localhost:3000 electron-forge start",
    "build": "npm run build:sdk && concurrently \"npm:build:ui\" \"npm:build:mcp-apps\"",
    "build:production": "npm run build:sdk && concurrently \"npm:build:ui\" \"npm:build:mcp-apps:production\"",
    "build:sdk": "cd artifacts/sdk && npm run build",
    "build:mcp-apps": "npx tsx scripts/buildMcpApps.ts",
    "build:mcp-apps:production": "npx tsx scripts/buildMcpApps.ts --production",
    "build:mcp-apps:notes": "npx tsx scripts/buildMcpApps.ts notes",
    "build:mcp-apps:todos": "npx tsx scripts/buildMcpApps.ts todos",
    "build:mcp-apps:crm": "npx tsx scripts/buildMcpApps.ts crm",
    "build:ui": "concurrently \"npm:build:ui:browser\" \"npm:build:ui:terminal\" \"npm:build:ui:ide\" \"npm:build:ui:popout\"",
    "build:ui:browser": "cross-env MCP_UI=browser vite build --config vite.ui.config.mts",
    "build:ui:terminal": "cross-env MCP_UI=terminal vite build --config vite.ui.config.mts",
    "build:ui:ide": "cross-env MCP_UI=ide vite build --config vite.ui.config.mts",
    "build:ui:popout": "vite build --config vite.popout.config.mts && npx tsx scripts/copyPopoutHtml.ts",
    "download:node": "npx tsx scripts/downloadNodeBinary.ts",
    "package": "npm run download:node && npm run build:production && electron-forge package",
    "make": "npm run build:production && electron-forge make",
    "publish": "npm run build:production && electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "Serverless Inc",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron-forge/plugin-vite": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "@reforged/maker-appimage": "^5.0.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "39.2.3",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "postcss": "^8.5.6",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.8.0",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.0",
    "@ai-sdk/anthropic": "^3.0.2",
    "@ai-sdk/devtools": "^0.0.3",
    "@ai-sdk/google-vertex": "^4.0.0",
    "@ai-sdk/react": "^3.0.6",
    "@modelcontextprotocol/ext-apps": "^0.2.2",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@monaco-editor/react": "^4.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@vscode/ripgrep": "^1.17.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "ai": "^6.0.6",
    "chokidar": "^3.6.0",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.7.3",
    "lottie-react": "^2.4.1",
    "node-pty": "1.1.0",
    "npm": "^10.9.2",
    "open-mcp-app": "file:./artifacts/sdk",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "sonner": "^2.0.7",
    "ws": "^8.18.0",
    "zod": "^3.24.4"
  }
}
